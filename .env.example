# =============================================================================
# DWO Graphic Design Masterclass — environment template
# Copy to .env.local for local dev, or import into Hostinger hPanel → Env vars.
# Never commit real secrets. Hostinger keys: A–Z, 0–9, _ only.
# =============================================================================

# Database (server-only — never expose to the browser)
# Local Docker: mysql://dwo:dwo_local_pass@127.0.0.1:3306/dwo_graphic_design_masterclass
# Hostinger (same account as Node app): use host "localhost" and the DB name/user
# from hPanel → Databases. Example:
# mysql://u123_user:PASSWORD@localhost:3306/u123_dbname
DATABASE_URL="mysql://user:password@localhost:3306/dwo_graphic_design_masterclass"

# Paystack (server-only — never prefix with NEXT_PUBLIC_)
# Only required when PAYMENT_MODE=PAYSTACK
PAYSTACK_SECRET_KEY=""

# Optional: only needed for client-side Paystack Popup integrations.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Public app URL (no trailing slash). Used for SEO, emails, Paystack callbacks.
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Active payment channel: MANUAL (MTN MoMo + admin verify) or PAYSTACK
PAYMENT_MODE="MANUAL"

# Email / SMTP (server-only — Hostinger-compatible)
# Hostinger mailbox typical values:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465  (SSL) or 587 (STARTTLS; then SMTP_SECURE=false)
# If unset, payments still succeed; confirmation emails are skipped.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="DWO Graphic Design & Media Class <noreply@your-domain.com>"

# Optional: organizer inbox for paid-registration alerts
REGISTRATION_NOTIFY_EMAIL=""

# Admin auth (server-only)
# Generate a long random string (32+ chars). Never expose as NEXT_PUBLIC_*.
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Cron auth for /api/payments/reconcile and /api/emails/payment-reminders
# On Hostinger (no Vercel Cron), call these URLs from an external cron
# with header: Authorization: Bearer <CRON_SECRET>
PAYMENT_RECONCILIATION_SECRET=""
CRON_SECRET=""

# Automated communication (server-only)
# Hours to wait before sending a pending-payment reminder (default: 24)
PAYMENT_REMINDER_AFTER_HOURS="24"
