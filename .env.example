# Database (server-only — never expose to the browser)
DATABASE_URL="mysql://user:password@localhost:3306/dwo_graphic_design_masterclass"

# Paystack (server-only — never prefix with NEXT_PUBLIC_)
# Test: sk_test_... from Paystack dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=""

# Optional: only needed for client-side Paystack Popup integrations.
# Phase 4 uses server-side initialization + redirect, so this is unused.
# Test: pk_test_... from the same Paystack page
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Public app URL used for Paystack callback redirects (no trailing slash)
# Example local: http://localhost:3000
# Example production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email / SMTP (server-only — Hostinger-compatible)
# If unset, payments still succeed; confirmation emails are skipped.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="DWO Graphic Design & Media Class <noreply@your-domain.com>"

# Optional: organizer inbox for paid-registration alerts
REGISTRATION_NOTIFY_EMAIL=""

# Admin auth (server-only)
# Generate a long random string (32+ chars). Never expose as NEXT_PUBLIC_*.
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Payment reconciliation cron (server-only)
# Used by GET/POST /api/payments/reconcile to recover paid-but-still-PENDING registrations.
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> when CRON_SECRET is set.
PAYMENT_RECONCILIATION_SECRET=""
CRON_SECRET=""

# Automated communication (server-only)
# Hours to wait before sending a pending-payment reminder (default: 24)
PAYMENT_REMINDER_AFTER_HOURS="24"
